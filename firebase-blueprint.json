{
  "entities": {
    "UserProfile": {
      "title": "User Profile",
      "description": "User profile information",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "maxLength": 128
        },
        "displayName": {
          "type": "string",
          "maxLength": 100
        },
        "email": {
          "type": "string",
          "maxLength": 100
        },
        "photoURL": {
          "type": "string",
          "maxLength": 500
        },
        "createdAt": {
          "type": "string"
        },
        "updatedAt": {
          "type": "string"
        }
      },
      "required": [
        "uid",
        "email"
      ]
    },
    "ChatSession": {
      "title": "Chat Session",
      "description": "User conversation session",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128
        },
        "title": {
          "type": "string",
          "maxLength": 200
        },
        "createdAt": {
          "type": "string"
        },
        "updatedAt": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "title"
      ]
    },
    "VoiceItem": {
      "title": "Generated Voice",
      "description": "Sudanese advertising voice item",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128
        },
        "text": {
          "type": "string",
          "maxLength": 1000
        },
        "voiceType": {
          "type": "string",
          "maxLength": 50
        },
        "createdAt": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "text"
      ]
    },
    "GeneratedImage": {
      "title": "Generated Image",
      "description": "AI generated image item",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128
        },
        "prompt": {
          "type": "string",
          "maxLength": 1000
        },
        "imageUrl": {
          "type": "string",
          "maxLength": 2000
        },
        "createdAt": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "prompt"
      ]
    },
    "Feedback": {
      "title": "App Feedback",
      "description": "User feedback submission",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128
        },
        "userId": {
          "type": "string",
          "maxLength": 128
        },
        "userName": {
          "type": "string",
          "maxLength": 100
        },
        "content": {
          "type": "string",
          "maxLength": 2000
        },
        "rating": {
          "type": "number"
        },
        "createdAt": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "userId",
        "content"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": {
        "$ref": "#/entities/UserProfile"
      },
      "description": "User profile collection"
    },
    "/users/{userId}/chats/{chatId}": {
      "schema": {
        "$ref": "#/entities/ChatSession"
      },
      "description": "User chats subcollection"
    },
    "/users/{userId}/voice_history/{voiceId}": {
      "schema": {
        "$ref": "#/entities/VoiceItem"
      },
      "description": "User generated voice audio history"
    },
    "/users/{userId}/generated_images/{imageId}": {
      "schema": {
        "$ref": "#/entities/GeneratedImage"
      },
      "description": "User generated image history"
    },
    "/app_feedback/{feedbackId}": {
      "schema": {
        "$ref": "#/entities/Feedback"
      },
      "description": "Public user feedback collection"
    }
  }
}
