# GEMINI_API_KEY: Required for Gemini AI (Text, Vision, Code, Voice, Audio generation).
# Get your key from https://aistudio.google.com/
GEMINI_API_KEY="your_gemini_api_key_here"

# ELEVENLABS_API_KEY: Optional ElevenLabs API Key for advanced Text-to-Speech voices.
ELEVENLABS_API_KEY="your_elevenlabs_api_key_here"

# APP_URL: The URL where the app is hosted (e.g. https://your-app.vercel.app).
APP_URL="https://your-app.vercel.app"

# NODE_ENV: Production status
NODE_ENV="production"

